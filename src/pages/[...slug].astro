---
import { Docs } from "@/components/docs";
import Layout from "@/components/layout.astro";
import Mermaid from "@/components/Mermaid.astro";
import { getPageImageUrl, source } from "@/lib/source";
import "@/styles/global.css";
import { render, type CollectionEntry } from "astro:content";
import type { TOCItemType } from "fumadocs-core/toc";
import {
  DocsBody,
  DocsDescription,
  DocsTitle,
} from "fumadocs-ui/layouts/docs/page";
import defaultMdxComponents from "fumadocs-ui/mdx";

interface Props {
  page: CollectionEntry<"docs">;
}

export async function getStaticPaths() {
  return source.getPages().map((page) => ({
    params: {
      slug: page.slugs.length > 0 ? page.slugs.join("/") : undefined,
    },
    props: { page: page.data._raw },
  }));
}

const { page } = Astro.props;
const { Content, headings } = await render(page);
const slugs =
  typeof Astro.params.slug === "string" ? Astro.params.slug.split("/") : [];
const docsPage = source.getPage(slugs)!;
const image = getPageImageUrl(docsPage);
const title = `${page.data.title} | React × Vue`;

const toc: TOCItemType[] = headings.map((heading) => ({
  depth: heading.depth,
  title: heading.text,
  url: `#${heading.slug}`,
}));
---

<Layout title={title} description={page.data.description} image={image}>
  <Docs
    tree={source.getPageTree()}
    pathname={Astro.url.pathname}
    params={Astro.params}
    page={{ toc }}
    client:load
  >
    <DocsTitle>{page.data.title}</DocsTitle>
    {
      page.data.description && (
        <DocsDescription>{page.data.description}</DocsDescription>
      )
    }
    <DocsBody>
      <Content components={{ ...defaultMdxComponents, Mermaid }} />
    </DocsBody>
  </Docs>
</Layout>
