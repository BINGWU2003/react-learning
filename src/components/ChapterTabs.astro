---
type Props = {
  hasFlow?: boolean;
  previewLabel?: string;
};

const { hasFlow = true, previewLabel = "在线对比" } = Astro.props;
const tabs = [
  { id: "preview", label: previewLabel },
  ...(hasFlow ? [{ id: "flow", label: "原理图" }] : []),
  { id: "source", label: "源码" },
];
---

<div class="chapter-tabs" data-chapter-tabs data-active-tab="preview">
  <div class="chapter-tabs__list" role="tablist" aria-label="章节内容">
    {
      tabs.map(({ id, label }, index) => (
        <button
          class="chapter-tabs__trigger"
          type="button"
          role="tab"
          aria-selected={index === 0 ? "true" : "false"}
          data-chapter-tab={id}
        >
          {label}
        </button>
      ))
    }
  </div>

  <section class="chapter-tabs__panel" role="tabpanel" data-chapter-panel="preview">
    <slot name="preview" />
  </section>
  {
    hasFlow && (
      <section
        class="chapter-tabs__panel"
        role="tabpanel"
        data-chapter-panel="flow"
        hidden
      >
        <slot name="flow" />
      </section>
    )
  }
  <section
    class="chapter-tabs__panel"
    role="tabpanel"
    data-chapter-panel="source"
    hidden
  >
    <slot name="source" />
  </section>
</div>

<script>
  function initializeChapterTabs() {
    const roots = Array.from(
      document.querySelectorAll<HTMLElement>(
        "[data-chapter-tabs]:not([data-chapter-tabs-ready])",
      ),
    );

    roots.forEach((root, rootIndex) => {
      root.dataset.chapterTabsReady = "true";
      const buttons = Array.from(
        root.querySelectorAll<HTMLButtonElement>("[data-chapter-tab]"),
      );
      const panels = Array.from(
        root.querySelectorAll<HTMLElement>("[data-chapter-panel]"),
      );
      const baseId = `chapter-tabs-${rootIndex}-${Math.random().toString(36).slice(2, 8)}`;

      buttons.forEach((button) => {
        const value = button.dataset.chapterTab ?? "preview";
        const panel = panels.find((item) => item.dataset.chapterPanel === value);
        button.id = `${baseId}-${value}-tab`;
        if (panel) {
          panel.id = `${baseId}-${value}-panel`;
          panel.setAttribute("aria-labelledby", button.id);
          button.setAttribute("aria-controls", panel.id);
        }
      });

      const activate = (value: string, focus = false) => {
        root.dataset.activeTab = value;
        buttons.forEach((button) => {
          const active = button.dataset.chapterTab === value;
          button.setAttribute("aria-selected", String(active));
          button.tabIndex = active ? 0 : -1;
          if (active && focus) button.focus();
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.chapterPanel !== value;
        });
        document.dispatchEvent(
          new CustomEvent("chapter-tab-change", { detail: { root, value } }),
        );
      };

      activate("preview");

      buttons.forEach((button, index) => {
        button.addEventListener("click", () => {
          activate(button.dataset.chapterTab ?? "preview");
        });
        button.addEventListener("keydown", (event) => {
          let nextIndex: number | undefined;
          if (event.key === "ArrowRight") nextIndex = (index + 1) % buttons.length;
          if (event.key === "ArrowLeft") nextIndex = (index - 1 + buttons.length) % buttons.length;
          if (event.key === "Home") nextIndex = 0;
          if (event.key === "End") nextIndex = buttons.length - 1;
          if (nextIndex === undefined) return;
          event.preventDefault();
          activate(buttons[nextIndex]?.dataset.chapterTab ?? "preview", true);
        });
      });
    });
  }

  initializeChapterTabs();
  document.addEventListener("astro:page-load", initializeChapterTabs);
</script>
