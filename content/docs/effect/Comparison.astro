---
import ChapterComparison from "@/components/ChapterComparison.astro";
import Flow from "./Flow.astro";
import { ReactDemo } from "./ReactDemo";
import VueDemo from "./VueDemo.vue";
import reactSource from "./ReactDemo.tsx?raw";
import vueSource from "./VueDemo.vue?raw";
---

<ChapterComparison
  react={{ framework: "React", tone: "react", summary: "useEffect 根据依赖重新连接，并在返回函数中清理旧连接。", sources: [{ code: reactSource, fileName: "ReactDemo.tsx", language: "tsx" }] }}
  vue={{ framework: "Vue 3", tone: "vue", summary: "watch 显式监听房间，并通过 onCleanup 清理上一次连接。", sources: [{ code: vueSource, fileName: "VueDemo.vue", language: "vue" }] }}
>
  <div slot="react-preview" class="chapter-demo"><ReactDemo client:only="react" /></div>
  <Flow slot="react-flow" framework="react" />
  <div slot="vue-preview" class="chapter-demo"><VueDemo client:only="vue" /></div>
  <Flow slot="vue-flow" framework="vue" />
</ChapterComparison>
