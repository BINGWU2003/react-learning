---
import ChapterComparison from "@/components/ChapterComparison.astro";
import Flow from "./Flow.astro";
import { ReactDemo } from "./ReactDemo";
import VueDemo from "./VueDemo.vue";
import reactDemoSource from "./ReactDemo.tsx?raw";
import reactHookSource from "./useViewportSize.ts?raw";
import vueDemoSource from "./VueDemo.vue?raw";
import vueComposableSource from "./useViewportSize.vue.ts?raw";
---

<ChapterComparison
  react={{ framework: "React", tone: "react", summary: "组件 render 时按固定顺序调用 Custom Hook。", sources: [
    { code: reactDemoSource, fileName: "ReactDemo.tsx", language: "tsx" },
    { code: reactHookSource, fileName: "useViewportSize.ts", language: "ts" },
  ] }}
  vue={{ framework: "Vue 3", tone: "vue", summary: "setup 调用 Composable 并获得可复用的响应式 refs。", sources: [
    { code: vueDemoSource, fileName: "VueDemo.vue", language: "vue" },
    { code: vueComposableSource, fileName: "useViewportSize.ts", language: "ts" },
  ] }}
>
  <div slot="react-preview" class="chapter-demo"><ReactDemo client:visible /></div>
  <Flow slot="react-flow" framework="react" />
  <div slot="vue-preview" class="chapter-demo"><VueDemo client:visible /></div>
  <Flow slot="vue-flow" framework="vue" />
</ChapterComparison>

