import VueDemo from "./VueDemo.vue";
import reactSource from "./ReactDemo.tsx?raw";
import vueSource from "./VueDemo.vue?raw";
---

<ChapterComparison
  react={{ framework: "React", tone: "react", summary: "调用 setter 并创建新的对象状态。", sources: [{ code: reactSource, fileName: "ReactDemo.tsx", language: "tsx" }] }}
  vue={{ framework: "Vue 3", tone: "vue", summary: "修改 ref.value 或 reactive 对象属性。", sources: [{ code: vueSource, fileName: "VueDemo.vue", language: "vue" }] }}
>
  <div slot="react-preview" class="chapter-demo"><ReactDemo client:visible /></div>
  <div slot="vue-preview" class="chapter-demo"><VueDemo client:visible /></div>
</ChapterComparison>
