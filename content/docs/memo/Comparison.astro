---
import ChapterComparison from "@/components/ChapterComparison.astro";
import Flow from "./Flow.astro";
import { ReactDemo } from "./ReactDemo";
import VueDemo from "./VueDemo.vue";
import reactSource from "./ReactDemo.tsx?raw";
import vueSource from "./VueDemo.vue?raw";
---

<ChapterComparison
  react={{ framework: "React", tone: "react", summary: "useMemo 根据手动依赖缓存筛选、排序和汇总结果。", sources: [{ code: reactSource, fileName: "ReactDemo.tsx", language: "tsx" }] }}
  vue={{ framework: "Vue 3", tone: "vue", summary: "computed 自动追踪读取的响应式状态并缓存结果。", sources: [{ code: vueSource, fileName: "VueDemo.vue", language: "vue" }] }}
>
  <div slot="react-preview" class="chapter-demo"><ReactDemo client:visible /></div>
  <Flow slot="react-flow" framework="react" />
  <div slot="vue-preview" class="chapter-demo"><VueDemo client:visible /></div>
  <Flow slot="vue-flow" framework="vue" />
</ChapterComparison>
