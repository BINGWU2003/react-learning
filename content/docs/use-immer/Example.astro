---
import FrameworkCard from "@/components/FrameworkCard.astro";
import Flow from "./Flow.astro";
import { ImmerDemo } from "./ImmerDemo";
import demoSource from "./ImmerDemo.tsx?raw";
import initialSource from "./initialPlan.ts?raw";
import styleSource from "./ImmerDemo.css?raw";
---

<div class="framework-comparison practice-example">
  <FrameworkCard
    framework="React"
    tone="react"
    summary="useImmer 用 Draft 简化嵌套对象与数组的不可变更新。"
    sources={[
      { code: demoSource, fileName: "ImmerDemo.tsx", language: "tsx" },
      { code: initialSource, fileName: "initialPlan.ts", language: "ts" },
      { code: styleSource, fileName: "ImmerDemo.css", language: "css" },
    ]}
  >
    <ImmerDemo client:visible />
    <Flow slot="flow" />
  </FrameworkCard>
</div>
