---
import ChapterTabs from "@/components/ChapterTabs.astro";
import FrameworkPanel from "@/components/FrameworkPanel.astro";
import { FrameworkSourceTabs } from "@/components/FrameworkSourceTabs";
import ComparisonFlow from "./ComparisonFlow.astro";
import PrincipleComparison from "./PrincipleComparison.astro";
import { ReactDemo } from "./ReactDemo";
import VueDemo from "./VueDemo.vue";
import reactSource from "./ReactDemo.tsx?raw";
import vueSource from "./VueDemo.vue?raw";
import reactModel from "./react-update-model.ts?raw";
import vueModel from "./vue-reactivity-model.ts?raw";
---

<ChapterTabs>
  <div slot="preview" class="chapter-grid">
    <FrameworkPanel framework="React" tone="react" summary="setter 请求更新；下一次 render 得到新的 state snapshot。">
      <ReactDemo client:visible />
    </FrameworkPanel>
    <FrameworkPanel framework="Vue 3" tone="vue" summary="读取时 track，赋值时 trigger 订阅了该属性的 effect。">
      <VueDemo client:visible />
    </FrameworkPanel>
  </div>

  <div slot="flow" class="reactivity-principles">
    <section>
      <h2>把两条链连起来</h2>
      <p>真实 Demo 展示的是结果，下面的双泳道把“保存状态”和“触发更新”连成一圈。虚线表示进入下一次交互或 render，而不是同步递归调用。</p>
      <ComparisonFlow />
    </section>
    <section>
      <h2>再拆核心原理</h2>
      <p>下面两段是刻意压缩的<strong>教学模型</strong>，用于保留最关键的数据流，不是 Vue、React、Fiber 或 Hooks 的真实源码。</p>
      <p>React 模型的 Hook 槽位部分受官方文档 <a href="https://zh-hans.react.dev/learn/state-a-components-memory#how-does-react-know-which-state-to-return">React 如何知道返回哪个 state？</a> 启发；这里额外接上了简化的调度步骤，以说明 setter 如何产生下一次 render。</p>
      <PrincipleComparison />
    </section>
  </div>

  <div slot="source" class="chapter-source">
    <FrameworkSourceTabs
      groups={[
        { label: "React", sources: [
          { code: reactSource, fileName: "ReactDemo.tsx", language: "tsx" },
          { code: reactModel, fileName: "react-update-model.ts", language: "ts" },
        ] },
        { label: "Vue 3", sources: [
          { code: vueSource, fileName: "VueDemo.vue", language: "vue" },
          { code: vueModel, fileName: "vue-reactivity-model.ts", language: "ts" },
        ] },
      ]}
      client:visible
    />
  </div>
</ChapterTabs>
