---
import { SourceTabs } from "@/components/SourceTabs";
import reactModel from "./react-update-model.ts?raw";
import vueModel from "./vue-reactivity-model.ts?raw";
---

<div class="principle-comparison">
  <article class="principle-card principle-card--vue">
    <header>
      <span>Vue 3 / STABLE REFS + PROPERTY GRAPH</span>
      <h3>setup 保存引用，属性读取建立依赖</h3>
      <p>setup 创建一次状态；effect 读取时 track，属性赋值时 trigger。</p>
    </header>
    <ol class="principle-steps" aria-label="Vue 响应式教学流程">
      <li><b>01</b><span>setup</span><strong>store</strong></li>
      <li><b>02</b><span>读取属性</span><strong>track</strong></li>
      <li><b>03</b><span>写入属性</span><strong>trigger → effect</strong></li>
    </ol>
    <div class="principle-code">
      <SourceTabs
        sources={[{
          code: vueModel,
          fileName: "vue-reactivity-model.ts",
          language: "ts",
        }]}
        client:visible
      />
    </div>
  </article>

  <article class="principle-card principle-card--react">
    <header>
      <span>React / HOOK SLOTS + RENDER PIPELINE</span>
      <h3>按 Hook 顺序找回 state，再调度 render</h3>
      <p>Hook 槽位回答“哪份 state”；setter 与调度回答“何时再执行”。</p>
    </header>
    <ol class="principle-steps" aria-label="React 状态更新教学流程">
      <li><b>01</b><span>useState</span><strong>Hook slot</strong></li>
      <li><b>02</b><span>setter</span><strong>enqueue</strong></li>
      <li><b>03</b><span>重新渲染</span><strong>reset → render</strong></li>
    </ol>
    <div class="principle-code">
      <SourceTabs
        sources={[{
          code: reactModel,
          fileName: "react-update-model.ts",
          language: "ts",
        }]}
        client:visible
      />
    </div>
  </article>
</div>

<style>
  .principle-comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: none;
    margin-top: 1.25rem;
  }

  .principle-card {
    --principle-color: var(--ui-accent);
    min-width: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    margin: 0;
    border: 1px solid var(--ui-ink);
    border-radius: var(--ui-radius-lg);
    background: var(--ui-surface);
    box-shadow: 3px 3px 0 var(--ui-line);
  }

  .principle-card--vue {
    --principle-color: var(--ui-vue);
  }

  .principle-card--react {
    --principle-color: var(--ui-react);
  }

  .principle-card header {
    min-height: 9.4rem;
    padding: 1rem 1.1rem;
    border-top: 3px solid var(--principle-color);
    border-bottom: 1px solid var(--ui-line);
  }

  .principle-card header span {
    color: var(--ui-ink-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .principle-card h3 {
    margin: 0.6rem 0 0;
    color: var(--ui-ink);
    font-size: 1rem;
  }

  .principle-card header p {
    margin: 0.45rem 0 0;
    color: var(--ui-ink-muted);
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .principle-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0;
    margin: 0;
    border-bottom: 1px solid var(--ui-line);
    list-style: none;
  }

  .principle-steps li {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
    padding: 0.7rem;
  }

  .principle-steps li + li {
    border-inline-start: 1px solid var(--ui-line);
  }

  .principle-steps b,
  .principle-steps strong {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
  }

  .principle-steps b {
    color: var(--principle-color);
  }

  .principle-steps span {
    overflow: hidden;
    color: var(--ui-ink-muted);
    font-size: 0.7rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .principle-steps strong {
    color: var(--ui-ink);
  }

  .principle-code {
    flex: 1;
    padding: 0.85rem;
    background: var(--ui-surface-muted);
  }

  .principle-code :global(figure) {
    max-height: 34rem;
    overflow: auto;
    border-radius: var(--ui-radius);
    box-shadow: none;
  }

  @media (max-width: 72rem) {
    .principle-comparison {
      grid-template-columns: 1fr;
    }

    .principle-card header {
      min-height: 0;
    }
  }

  @media (max-width: 30rem) {
    .principle-comparison {
      margin-inline: -1rem;
    }

    .principle-card {
      border-inline: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .principle-steps li {
      padding-inline: 0.55rem;
    }
  }
</style>
