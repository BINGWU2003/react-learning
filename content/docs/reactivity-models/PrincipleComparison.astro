---
import { SourceTabs } from "@/components/SourceTabs";
import { Card } from "fumadocs-ui/components/card";
import { Step, Steps } from "fumadocs-ui/components/steps";
import reactModel from "./react-update-model.ts?raw";
import vueModel from "./vue-reactivity-model.ts?raw";
---

<div class="principle-comparison">
  <Card title="Vue 3" description="setup 保存引用，属性读取建立依赖" className="principle-card principle-card--vue">
    <Steps>
      <Step><h4>setup</h4><p>创建并保存响应式引用。</p></Step>
      <Step><h4>track</h4><p>effect 读取属性时建立依赖。</p></Step>
      <Step><h4>trigger</h4><p>属性写入后通知对应 effect。</p></Step>
    </Steps>
    <div class="principle-code">
      <SourceTabs
        sources={[{
          code: vueModel,
          fileName: "vue-reactivity-model.ts",
          language: "ts",
        }]}
        client:visible
      />
    </div>
  </Card>

  <Card title="React" description="按 Hook 顺序找回 state，再调度 render" className="principle-card principle-card--react">
    <Steps>
      <Step><h4>Hook slot</h4><p>useState 按调用顺序找到状态。</p></Step>
      <Step><h4>enqueue</h4><p>setter 把更新加入队列。</p></Step>
      <Step><h4>render</h4><p>重置 Hook 索引并重新执行组件。</p></Step>
    </Steps>
    <div class="principle-code">
      <SourceTabs
        sources={[{
          code: reactModel,
          fileName: "react-update-model.ts",
          language: "ts",
        }]}
        client:visible
      />
    </div>
  </Card>
</div>

<style>
  .principle-comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    max-width: none;
    margin-top: 1.25rem;
  }

  .principle-card {
    --principle-color: var(--ui-accent);
    min-width: 0;
    margin: 0;
    box-shadow: none;
  }

  .principle-card--vue {
    --principle-color: var(--ui-vue);
  }

  .principle-card--react {
    --principle-color: var(--ui-react);
  }

  .principle-card :global(.fd-steps) {
    margin-top: 1rem;
  }

  .principle-code {
    margin-top: 1rem;
  }

  .principle-code :global(figure) {
    max-height: 34rem;
    overflow: auto;
    border-radius: var(--ui-radius);
    box-shadow: none;
  }

  @media (max-width: 63.999rem) {
    .principle-comparison {
      grid-template-columns: 1fr;
    }

  }
</style>
